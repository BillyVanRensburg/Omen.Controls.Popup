<Window x:Class="Omen.Controls.Popup.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:omen="clr-namespace:Omen.Controls.Popup.WPF.Controls;assembly=Omen.Controls.Popup.WPF"
        Title="OmenPopup Demo" Height="450" Width="400">
    <Grid>
        <StackPanel Margin="20">
            <Button x:Name="ShowButton" 
                    Content="Show Modal Popup" 
                    Click="ShowButton_Click" 
                    Width="160" Height="30" 
                    Margin="0,5"/>
            <CheckBox x:Name="EscapeCheckBox" 
                      Content="Close on Escape (CanCloseOnEscape)" 
                      IsChecked="True" 
                      Margin="0,20,0,0"/>
            <TextBlock Text="Press Escape to close (if enabled)" 
                       Margin="0,10,0,0" 
                       Foreground="Gray" 
                       FontSize="12"/>
        </StackPanel>
        <omen:OmenPopup x:Name="TestPopup" />
    </Grid>
</Window>