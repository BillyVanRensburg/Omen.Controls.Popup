<Window x:Class="Omen.Controls.Popup.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:omen="clr-namespace:Omen.Controls.Popup.WPF.Controls;assembly=Omen.Controls.Popup.WPF"
        Title="OmenPopup Demo" Height="700" Width="800">
    <Window.Resources>
        <ControlTemplate x:Key="CustomCloseButtonTemplate" TargetType="Button">
            <Border Background="Red" Width="26" Height="26" CornerRadius="13" Cursor="Hand">
                <TextBlock Text="X" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scrollable settings area with two columns -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1 -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <!-- Mode -->
                    <GroupBox Header="Mode" Margin="0,5">
                        <StackPanel Margin="5">
                            <RadioButton x:Name="ModalRadio" Content="Modal (overlay)" IsChecked="True" Margin="0,3"/>
                            <RadioButton x:Name="LightweightRadio" Content="Lightweight (floating)" Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Lightweight Options (anchor only) -->
                    <GroupBox Header="Lightweight Options" Margin="0,5">
                        <StackPanel Margin="5">
                            <RadioButton x:Name="AnchorToButtonRadio" Content="Anchor to 'Show Popup' button" GroupName="Anchor" IsChecked="True" Margin="0,3"/>
                            <RadioButton x:Name="AnchorToMouseRadio" Content="Anchor to mouse cursor" GroupName="Anchor" Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Popup Options (includes unified "Stay open on outside click") -->
                    <GroupBox Header="Popup Options" Margin="0,5">
                        <StackPanel Margin="5">
                            <CheckBox x:Name="AsyncCheckBox" Content="Use Async (await)" IsChecked="True" Margin="0,3"/>
                            <CheckBox x:Name="StayOpenOutsideCheckBox" Content="Stay open on outside click" IsChecked="True" Margin="0,3"/>
                            <CheckBox x:Name="EscapeCheckBox" Content="Close on Escape" IsChecked="True" Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Close Button Options -->
                    <GroupBox Header="Close Button Options" Margin="0,5">
                        <StackPanel Margin="5">
                            <CheckBox x:Name="ShowCloseButtonCheckBox" Content="Show Close Button" IsChecked="True" Margin="0,3"/>
                            <CheckBox x:Name="CustomCloseButtonCheckBox" Content="Use Custom Close Button Template" Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- Column 2 -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <!-- Animation Settings -->
                    <GroupBox Header="Animation Settings" Margin="0,5">
                        <StackPanel Margin="5">
                            <TextBlock Text="Enter Animation:" Margin="0,5,0,0"/>
                            <ComboBox x:Name="EnterAnimationCombo" Width="200" SelectedIndex="0">
                                <ComboBoxItem Content="Fade" Tag="Fade"/>
                                <ComboBoxItem Content="Scale" Tag="Scale"/>
                                <ComboBoxItem Content="Slide From Top" Tag="SlideFromTop"/>
                                <ComboBoxItem Content="Slide From Bottom" Tag="SlideFromBottom"/>
                                <ComboBoxItem Content="Slide From Left" Tag="SlideFromLeft"/>
                                <ComboBoxItem Content="Slide From Right" Tag="SlideFromRight"/>
                                <ComboBoxItem Content="Fade + Scale" Tag="Fade,Scale"/>
                                <ComboBoxItem Content="Fade + SlideFromTop" Tag="Fade,SlideFromTop"/>
                                <ComboBoxItem Content="Scale + SlideFromBottom" Tag="Scale,SlideFromBottom"/>
                                <ComboBoxItem Content="None" Tag="None"/>
                            </ComboBox>
                            <TextBlock Text="Exit Animation:" Margin="0,5,0,0"/>
                            <ComboBox x:Name="ExitAnimationCombo" Width="200" SelectedIndex="0">
                                <ComboBoxItem Content="Fade" Tag="Fade"/>
                                <ComboBoxItem Content="Scale" Tag="Scale"/>
                                <ComboBoxItem Content="Slide From Top" Tag="SlideFromTop"/>
                                <ComboBoxItem Content="Slide From Bottom" Tag="SlideFromBottom"/>
                                <ComboBoxItem Content="Slide From Left" Tag="SlideFromLeft"/>
                                <ComboBoxItem Content="Slide From Right" Tag="SlideFromRight"/>
                                <ComboBoxItem Content="Fade + Scale" Tag="Fade,Scale"/>
                                <ComboBoxItem Content="Fade + SlideFromTop" Tag="Fade,SlideFromTop"/>
                                <ComboBoxItem Content="Scale + SlideFromBottom" Tag="Scale,SlideFromBottom"/>
                                <ComboBoxItem Content="None" Tag="None"/>
                            </ComboBox>
                            <TextBlock Text="Duration (ms):" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="DurationSlider" Minimum="50" Maximum="500" Value="200" TickFrequency="50" IsSnapToTickEnabled="True" Width="150"/>
                                <TextBlock Text="{Binding Value, ElementName=DurationSlider, StringFormat={}{0:F0} ms}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Easing:" Margin="0,5,0,0"/>
                            <ComboBox x:Name="EasingCombo" Width="150" SelectedIndex="2">
                                <ComboBoxItem Content="Linear" Tag="Linear"/>
                                <ComboBoxItem Content="Ease In" Tag="EaseIn"/>
                                <ComboBoxItem Content="Ease Out" Tag="EaseOut"/>
                                <ComboBoxItem Content="Ease In Out" Tag="EaseInOut"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <!-- Content -->
                    <GroupBox Header="Content" Margin="0,5">
                        <StackPanel Margin="5">
                            <RadioButton x:Name="TextContentRadio" Content="Simple Text" IsChecked="True" Margin="0,3"/>
                            <RadioButton x:Name="DialogContentRadio" Content="Dialog with OK/Cancel Buttons" Margin="0,3"/>
                            <TextBox x:Name="TextContentBox" Text="This is a sample popup message." Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Status text -->
                    <TextBlock x:Name="StatusText" Text="Ready" Margin="0,10" Foreground="DarkGreen" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Button row at bottom -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="ShowButton" Content="Show Popup" Click="ShowButton_Click" Width="120" Height="30" Margin="5"/>
            <Button x:Name="CloseButton" Content="Force Close" Click="CloseButton_Click" Width="120" Height="30" Margin="5"/>
        </StackPanel>

        <!-- OmenPopup control overlaying the window -->
        <omen:OmenPopup x:Name="TestPopup" />
    </Grid>
</Window>