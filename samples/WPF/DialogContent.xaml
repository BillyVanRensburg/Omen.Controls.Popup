<UserControl x:Class="Omen.Controls.Popup.Sample.DialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="150" Width="300">
    <StackPanel Margin="20">
        <TextBlock Text="Separate XAML File" FontSize="16" Margin="0,0,0,10" TextAlignment="Center"/>
        <TextBlock Text="This content comes from a UserControl." Margin="0,0,0,20" TextAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="OK" Width="80" Height="30" Margin="0,0,10,0" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80" Height="30" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>