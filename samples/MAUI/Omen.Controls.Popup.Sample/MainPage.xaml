<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:popup="clr-namespace:Omen.Controls.Popup.MAUI.Controls;assembly=Omen.Controls.Popup.MAUI"
             xmlns:local="clr-namespace:Omen.Controls.Popup.Sample"
             x:Class="Omen.Controls.Popup.Sample.MainPage"
             Title="OmenPopup Demo">

    <ContentPage.Resources>
        <ControlTemplate x:Key="CustomCloseButtonTemplate">
            <Button Text="✖" BackgroundColor="Red" TextColor="White"
                    CornerRadius="13" WidthRequest="26" HeightRequest="26"
                    HorizontalOptions="End" VerticalOptions="Start"
                    Margin="0,5,5,0" />
        </ControlTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" Padding="10" RowSpacing="10">
        <ScrollView Grid.Row="0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <!-- Column 1 -->
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <!-- Mode -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="Mode" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <RadioButton x:Name="ModalRadio" Content="Modal (overlay)" IsChecked="True"/>
                            <RadioButton x:Name="LightweightRadio" Content="Lightweight (floating)"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Popup Options -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="Popup Options" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="AsyncCheckBox" IsChecked="True"/>
                                <Label Text="Use Async (await)" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="CloseOnOutsideClickCheckBox" IsChecked="True"/>
                                <Label Text="Close on outside click" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="EscapeCheckBox" IsChecked="True"/>
                                <Label Text="Close on Escape" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Close Button Options -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="Close Button Options" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="ShowCloseButtonCheckBox" IsChecked="True"/>
                                <Label Text="Show Close Button" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="CustomCloseButtonCheckBox"/>
                                <Label Text="Use Custom Close Button Template" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Overlay Brush -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="Overlay Brush (Modal)" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Picker x:Name="OverlayBrushPicker" SelectedIndex="0">
                                <Picker.Items>
                                    <x:String>Black 50%</x:String>
                                    <x:String>Black 70%</x:String>
                                    <x:String>White 50%</x:String>
                                    <x:String>Custom</x:String>
                                </Picker.Items>
                            </Picker>
                            <Grid x:Name="CustomOverlayPanel" IsVisible="False">
                                <Entry x:Name="CustomOverlayBrushBox" Text="#80000000" Placeholder="#AARRGGBB" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Anchor Elements -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="Anchor Elements (for UI Element anchor)" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Grid ColumnDefinitions="*,*">
                                <Border x:Name="LeftElement" Grid.Column="0" Background="LightBlue"
                                        HeightRequest="200" Margin="2">
                                    <Label Text="Left UI Element" HorizontalOptions="Center" VerticalOptions="Center"
                                           FontSize="16" FontAttributes="Bold"/>
                                </Border>
                                <Border x:Name="RightElement" Grid.Column="1" Background="LightGreen"
                                        HeightRequest="200" Margin="2">
                                    <Label Text="Right UI Element" HorizontalOptions="Center" VerticalOptions="Center"
                                           FontSize="16" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Column 2 -->
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <!-- Positioning -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="Positioning" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Label Text="Anchor Target:" />
                            <Picker x:Name="AnchorTargetPicker" SelectedIndex="0">
                                <Picker.Items>
                                    <x:String>Parent Container</x:String>
                                    <x:String>UI Element</x:String>
                                    <x:String>Mouse Cursor</x:String>
                                    <x:String>Custom Coordinates</x:String>
                                </Picker.Items>
                            </Picker>

                            <Grid x:Name="AnchorElementPanel" IsVisible="False">
                                <Label Text="Anchor Element:" />
                                <Picker x:Name="AnchorElementPicker" Title="Select UI Element">
                                    <Picker.Items>
                                        <x:String>Left UI Element</x:String>
                                        <x:String>Right UI Element</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Grid>

                            <Grid x:Name="CustomCoordsPanel" IsVisible="False">
                                <Label Text="Custom X,Y:" />
                                <HorizontalStackLayout Spacing="5">
                                    <Entry x:Name="CustomXBox" Text="0" Keyboard="Numeric" WidthRequest="60"/>
                                    <Entry x:Name="CustomYBox" Text="0" Keyboard="Numeric" WidthRequest="60"/>
                                </HorizontalStackLayout>
                            </Grid>

                            <Label Text="Alignment:" Margin="0,5,0,0"/>
                            <Picker x:Name="AlignmentPicker" SelectedIndex="4">
                                <Picker.Items>
                                    <x:String>Top Left</x:String>
                                    <x:String>Top Center</x:String>
                                    <x:String>Top Right</x:String>
                                    <x:String>Left Center</x:String>
                                    <x:String>Middle Center</x:String>
                                    <x:String>Right Center</x:String>
                                    <x:String>Bottom Left</x:String>
                                    <x:String>Bottom Center</x:String>
                                    <x:String>Bottom Right</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Offset (X,Y):"/>
                            <HorizontalStackLayout Spacing="5">
                                <Entry x:Name="OffsetXBox" Text="0" Keyboard="Numeric" WidthRequest="50"/>
                                <Entry x:Name="OffsetYBox" Text="0" Keyboard="Numeric" WidthRequest="50"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="AutoFlipCheckBox" IsChecked="True"/>
                                <Label Text="Auto‑flip" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Animation Settings -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="Animation Settings" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Label Text="Enter Animation:"/>
                            <Picker x:Name="EnterAnimationPicker" SelectedIndex="0">
                                <Picker.Items>
                                    <x:String>Fade</x:String>
                                    <x:String>Scale</x:String>
                                    <x:String>Slide Top</x:String>
                                    <x:String>Slide Bottom</x:String>
                                    <x:String>Slide Left</x:String>
                                    <x:String>Slide Right</x:String>
                                    <x:String>Fade + Scale</x:String>
                                    <x:String>Fade + SlideTop</x:String>
                                    <x:String>Scale + SlideBottom</x:String>
                                    <x:String>None</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Exit Animation:"/>
                            <Picker x:Name="ExitAnimationPicker" SelectedIndex="0">
                                <Picker.Items>
                                    <x:String>Fade</x:String>
                                    <x:String>Scale</x:String>
                                    <x:String>Slide Top</x:String>
                                    <x:String>Slide Bottom</x:String>
                                    <x:String>Slide Left</x:String>
                                    <x:String>Slide Right</x:String>
                                    <x:String>Fade + Scale</x:String>
                                    <x:String>Fade + SlideTop</x:String>
                                    <x:String>Scale + SlideBottom</x:String>
                                    <x:String>None</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Duration (ms):"/>
                            <Slider x:Name="DurationSlider" Minimum="50" Maximum="500" Value="200"/>
                            <Label x:Name="DurationLabel" Text="200 ms" FontSize="12"/>

                            <Label Text="Easing:"/>
                            <Picker x:Name="EasingPicker" SelectedIndex="2">
                                <Picker.Items>
                                    <x:String>Linear</x:String>
                                    <x:String>Ease In</x:String>
                                    <x:String>Ease Out</x:String>
                                    <x:String>Ease In Out</x:String>
                                    <x:String>Cubic Bezier</x:String>
                                </Picker.Items>
                            </Picker>

                            <Grid x:Name="CubicBezierPanel" IsVisible="False">
                                <Label Text="Cubic Bezier Points (X1,Y1,X2,Y2):"/>
                                <Entry x:Name="CubicBezierPointsBox" Text="0.25,0.1,0.25,1.0"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Dialog Buttons -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5"
                            IsEnabled="{Binding Source={x:Reference ModalRadio}, Path=IsChecked}">
                        <VerticalStackLayout>
                            <Label Text="Dialog Buttons (Modal)" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="ChkOK" IsChecked="True"/>
                                <Label Text="OK" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="ChkCancel" IsChecked="True"/>
                                <Label Text="Cancel" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="ChkYes"/>
                                <Label Text="Yes" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="ChkNo"/>
                                <Label Text="No" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Label Text="Custom Labels:" Margin="0,5,0,0"/>
                            <HorizontalStackLayout Spacing="5">
                                <Entry x:Name="TxtOK" Text="OK" WidthRequest="60"/>
                                <Entry x:Name="TxtCancel" Text="Cancel" WidthRequest="60"/>
                                <Entry x:Name="TxtYes" Text="Yes" WidthRequest="60"/>
                                <Entry x:Name="TxtNo" Text="No" WidthRequest="60"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Content -->
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="5" Margin="0,5">
                        <VerticalStackLayout>
                            <Label Text="Content" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <RadioButton x:Name="TextContentRadio" Content="Simple Text" IsChecked="True"/>
                            <RadioButton x:Name="CustomContentRadio" Content="Custom Control (DialogContent)"/>
                            <Entry x:Name="TextContentBox" Text="This is a sample popup message."/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Status -->
                    <Label x:Name="StatusText" Text="Ready" TextColor="DarkGreen" HorizontalTextAlignment="Center" Margin="0,10"/>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Buttons at bottom -->
        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="10" Margin="10">
            <Button x:Name="ShowButton" Text="Show Popup" Clicked="ShowButton_Clicked"
                    WidthRequest="120" HeightRequest="40" BackgroundColor="#512BD4" TextColor="White"/>
            <Button x:Name="CloseButton" Text="Force Close" Clicked="CloseButton_Clicked"
                    WidthRequest="120" HeightRequest="40" BackgroundColor="Gray" TextColor="White"/>
        </HorizontalStackLayout>

        <!-- The popup control -->
        <popup:OmenPopup x:Name="TestPopup" />
    </Grid>
</ContentPage>