<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Omen.Controls.Popup.Sample.DialogContent">
    <VerticalStackLayout Spacing="10" Padding="10" BackgroundColor="White">
        <Label Text="Enter your name:" FontSize="14" HorizontalTextAlignment="Center"/>
        <Entry x:Name="NameEntry" Placeholder="Your name" />
        <Button Text="Submit" Clicked="SubmitButton_Clicked" BackgroundColor="LightGray" TextColor="Black"/>
    </VerticalStackLayout>
</ContentView>