<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Omen.Controls.Popup.WPF.Controls">
    <Style TargetType="{x:Type local:OmenPopup}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OmenPopup}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<DataTemplate x:Key="DefaultCloseButtonTemplate">
		<Border Background="Transparent" Width="28" Height="28" CornerRadius="2" Cursor="Hand">
			<TextBlock Text="✖" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Border>
	</DataTemplate>
	
</ResourceDictionary>